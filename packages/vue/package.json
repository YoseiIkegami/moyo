{
  "name": "@ikg-systems/moyo-vue",
  "version": "0.1.0",
  "description": "Vue 3 components for Moyo — organic loading blobs.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Yosei Ikegami (IKG Systems)",
  "homepage": "https://github.com/YoseiIkegami/moyo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoseiIkegami/moyo.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/YoseiIkegami/moyo/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "svg",
    "blob",
    "loader",
    "animation",
    "moyo"
  ],
  "scripts": {
    "build": "vue-tsc --noEmit && vite build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@ikg-systems/moyo": "^0.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
