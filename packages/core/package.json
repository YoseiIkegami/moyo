{
  "name": "@ikg-systems/moyo",
  "version": "0.1.0",
  "description": "Organic loading blobs. Motion-first, framework-agnostic SVG shape engine.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Yosei Ikegami (IKG Systems)",
  "homepage": "https://github.com/ikg-systems/moyo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikg-systems/moyo.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ikg-systems/moyo/issues"
  },
  "keywords": [
    "svg",
    "blob",
    "animation",
    "loader",
    "organic",
    "shape",
    "metaball",
    "morph"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
